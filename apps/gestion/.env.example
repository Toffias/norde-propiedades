# Base de datos (PostgreSQL compartido por las tres apps)
DATABASE_URL=postgres://norde:norde@localhost:5432/norde

# Sesiones del panel (Better Auth). El secreto: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Nivel de log: fatal, error, warn, info (por defecto), debug o trace
LOG_LEVEL=
