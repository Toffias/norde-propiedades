# Servidor
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info

# Base de datos (PostgreSQL compartido por las tres apps)
DATABASE_URL=postgres://norde:norde@localhost:5432/norde

# Sitio público (links a las fichas que manda el agente)
PUBLIC_SITE_URL=http://localhost:3000

# Agente de IA (OpenAI). Obligatorio si WhatsApp o el chat del sitio están configurados.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Tope de gasto en OpenAI de las últimas 24 h (USD). Vacío: solo se mide y se loguea.
AGENT_DAILY_BUDGET_USD=
# Precios del modelo en USD por millón de tokens, para estimar el gasto.
OPENAI_PRICE_INPUT_PER_MTOK=0.25
OPENAI_PRICE_CACHED_INPUT_PER_MTOK=0.025
OPENAI_PRICE_OUTPUT_PER_MTOK=2
# Moderación de OpenAI antes de cada turno.
AGENT_MODERATION=true
# Transcripción de los audios de WhatsApp.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AGENT_MAX_MEMORY_ITEMS=60
AGENT_BREAKER_THRESHOLD=5
AGENT_BREAKER_COOLDOWN_MINUTES=10

# Conversaciones
CONVERSATION_IDLE_RESET_HOURS=24
MAX_INBOUND_TEXT_CHARS=1000
MAX_INBOUND_AGE_HOURS=12

# WhatsApp Cloud API: el canal se habilita si están las cuatro primeras.
# Guía: C:\APZ-WP-BOT\docs\WHATSAPP-SETUP.md (token de System User, app en modo Live).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Solo con el número de prueba de Meta (quita el 9 de los celulares argentinos)
WHATSAPP_STRIP_AR_NINE=false
WHATSAPP_DEBOUNCE_MS=4000
LIMIT_CONTACT_MESSAGES_PER_HOUR=30
LIMIT_CONTACT_MESSAGES_PER_DAY=120
LIMIT_WHATSAPP_OUTBOUND_PER_DAY=3000

# Chat del sitio (ADR 0037): el mismo valor que AGENT_CHAT_SECRET de apps/web (32+ caracteres).
# Sin él, el endpoint del chat no se expone. Necesita OPENAI_API_KEY.
WEB_CHAT_SECRET=
LIMIT_WEB_CHAT_REPLIES_PER_DAY=2000
