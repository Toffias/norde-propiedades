# Base de datos (PostgreSQL compartido por las tres apps)
DATABASE_URL=postgres://norde:norde@localhost:5432/norde

# Sesiones del panel (Better Auth). El secreto: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Nivel de log: fatal, error, warn, info (por defecto), debug o trace
LOG_LEVEL=

# Storage de archivos (logos, marca de agua, gestor de archivos): `local` (desarrollo) o `s3`
STORAGE_DRIVER=local
# Carpeta del storage local (por defecto `.storage`, ignorada por git)
STORAGE_LOCAL_DIR=
# S3 compatible (Cloudflare R2 o AWS S3), obligatorias con STORAGE_DRIVER=s3.
# En R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com y S3_REGION=auto
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Emails de salida (Resend). Sin estas dos, el envío avisa que falta configurarlo.
RESEND_API_KEY=
# Dirección en un dominio verificado en Resend (ej. avisos@norde.com.ar)
MAIL_FROM_ADDRESS=
