# Servidor
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info

# Base de datos (PostgreSQL compartido por las tres apps)
DATABASE_URL=postgres://norde:norde@localhost:5432/norde

# Sitio público (links a las fichas que manda el agente)
PUBLIC_SITE_URL=http://localhost:3000

# Agente de IA (OpenAI). Obligatorio si WhatsApp está configurado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AGENT_MAX_MEMORY_ITEMS=60
AGENT_BREAKER_THRESHOLD=5
AGENT_BREAKER_COOLDOWN_MINUTES=10

# Conversaciones
CONVERSATION_IDLE_RESET_HOURS=24
MAX_INBOUND_TEXT_CHARS=1000
MAX_INBOUND_AGE_HOURS=12

# WhatsApp Cloud API: el canal se habilita si están las cuatro primeras.
# Guía: C:\APZ-WP-BOT\docs\WHATSAPP-SETUP.md (token de System User, app en modo Live).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Solo con el número de prueba de Meta (quita el 9 de los celulares argentinos)
WHATSAPP_STRIP_AR_NINE=false
WHATSAPP_DEBOUNCE_MS=4000
LIMIT_CONTACT_MESSAGES_PER_HOUR=30
LIMIT_CONTACT_MESSAGES_PER_DAY=120
LIMIT_WHATSAPP_OUTBOUND_PER_DAY=3000

# Avisos al equipo cuando entra una oportunidad (Slack, Teams, n8n…). Sin URL, van al log.
TEAM_WEBHOOK_URL=
TEAM_WEBHOOK_TOKEN=

# Consultas del formulario web: secreto compartido con apps/web (32 caracteres o más).
# Sin secreto, el webhook no se expone.
INQUIRY_WEBHOOK_SECRET=
INQUIRY_WEBHOOK_RATE_PER_MINUTE=60
# Reparto automático de consultas por reglas (#48), en pausa
INQUIRY_RULES_ENABLED=false

# Relay del outbox y workers de pg-boss
JOBS_ENABLED=true

# Storage de archivos (variantes de fotos y PDF de la ficha). Igual que en apps/gestion.
# En desarrollo, la carpeta del panel: ../gestion/.storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
