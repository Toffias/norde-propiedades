    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@norde/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
