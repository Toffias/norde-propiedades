# Nivel de log: fatal, error, warn, info (por defecto), debug o trace
LOG_LEVEL=

# Base de datos (PostgreSQL compartido; Payload usa el esquema "payload")
DATABASE_URL=postgres://norde:norde@localhost:5432/norde

# Secreto de Payload (firma de sesiones del admin). En producción: string largo y aleatorio.
PAYLOAD_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# URL pública del sitio
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Fotos de las propiedades (ADR 0023): el mismo bucket privado que apps/gestion, con una clave de
# solo lectura propia. `local` (desarrollo) lee la carpeta del panel; en producción, `s3`.
STORAGE_DRIVER=local
# Carpeta del storage local (por defecto ../gestion/.storage, la del panel)
STORAGE_LOCAL_DIR=
# S3 compatible (Cloudflare R2 o AWS S3), obligatorias con STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# Carpeta dentro del bucket si se comparte con otros proyectos (norde-uat). Vacía: la raíz
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Secreto compartido con WEB_REVALIDATE_SECRET de apps/gestion (32 caracteres o más): firma los
# avisos de cambios de propiedades. Sin secreto, POST /api/revalidate no se expone y las fichas
# se refrescan solas cada hora
REVALIDATE_SECRET=

# Consultas del formulario de la ficha: el webhook de apps/gestion y el mismo secreto que su
# INQUIRY_WEBHOOK_SECRET. Las dos o ninguna; sin ellas, la ficha ofrece solo WhatsApp
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# Chat con el agente de IA (ADR 0037): el endpoint de apps/agent y el mismo secreto que su
# WEB_CHAT_SECRET (32 caracteres o más). Las dos o ninguna; sin ellas, no se muestra la burbuja
AGENT_CHAT_URL=
AGENT_CHAT_SECRET=
