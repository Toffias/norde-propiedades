# Base de datos (PostgreSQL compartido por las tres apps)
DATABASE_URL=postgres://norde:norde@localhost:5432/norde

# Sesiones del panel (Better Auth). El secreto: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Nivel de log: fatal, error, warn, info (por defecto), debug o trace
LOG_LEVEL=

# Storage de archivos (logos, marca de agua, gestor de archivos): `local` (desarrollo) o `s3`.
# Obligatoria en producción.
STORAGE_DRIVER=local
# Carpeta del storage local (por defecto `.storage`, ignorada por git)
STORAGE_LOCAL_DIR=
# S3 compatible (Cloudflare R2 o AWS S3), obligatorias con STORAGE_DRIVER=s3.
# En R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com y S3_REGION=auto
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Emails de salida (Resend). Sin estas dos, el envío avisa que falta configurarlo.
RESEND_API_KEY=
# Dirección en un dominio verificado en Resend (ej. avisos@norde.com.ar)
MAIL_FROM_ADDRESS=

# Geocodificación de direcciones (Nominatim de OpenStreetMap). Su política de uso pide identificar la
# app con un contacto, ej. NordePropiedades/1.0 (sistemas@norde.com.ar)
GEOCODER_USER_AGENT=
# Otra instancia de Nominatim (por defecto, la pública de OpenStreetMap)
GEOCODER_URL=

# Relay del outbox y workers de pg-boss (variantes de fotos, PDF, importaciones, reglas,
# supresión y unificación). Con `false`, los eventos esperan en el outbox (ADR 0021)
JOBS_ENABLED=true

# Avisos al equipo cuando entra una oportunidad (Slack, Teams, n8n…). Sin URL, van al log
TEAM_WEBHOOK_URL=
TEAM_WEBHOOK_TOKEN=

# Consultas del formulario web: secreto compartido con apps/web (32 caracteres o más).
# Sin secreto, POST /api/webhooks/inquiries/web no se expone
INQUIRY_WEBHOOK_SECRET=
INQUIRY_WEBHOOK_RATE_PER_MINUTE=60

# Reglas de asignación de consultas (#48), en pausa: `true` muestra /consultas/reglas y reparte
# las consultas por reglas. Las chances de los emprendimientos (#7) reparten igual
INQUIRY_RULES_ENABLED=false

# Funciones de Tokko que Norde no usa hoy (#50), ocultas: `true` muestra cada una
# Mi empresa → Marca de agua
WATERMARK_ENABLED=false
# Mi empresa → Códigos (prefijos por tipo, usuario, equipo o sucursal; sin ella se usa el general)
REFERENCE_CODES_ENABLED=false
# Mi empresa → Equipos, y sus permisos en Roles y Usuarios
TEAMS_ENABLED=false
# Atributos personalizados: Mi empresa → Propiedades y la ficha de la propiedad
CUSTOM_ATTRIBUTES_ENABLED=false

# Difusión en portales (#14), en construcción: `true` muestra Mi empresa → Portales → cuentas
PORTALS_ENABLED=false
# Cifra los tokens de los portales en la base: `openssl rand -base64 32`. Obligatoria con
# PORTALS_ENABLED=true; cambiarla obliga a volver a conectar las cuentas
PORTALS_SECRET_KEY=
# App de MercadoLibre (DevCenter): las tres o ninguna. La URL de vuelta tiene que ser HTTPS y
# exactamente la registrada en la app: <panel>/api/portals/mercadolibre/callback
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REDIRECT_URI=
